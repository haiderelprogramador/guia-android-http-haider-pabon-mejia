<?xml version="1.0" encoding="utf-8"?>
<!-- AndroidManifest.xml - Haider Pabon Mejia -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- usesCleartextTraffic: permite conexiones http:// (sin https) al servidor WAMP.
         Sin esto, Android 9 o superior bloquea la conexion. -->
    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".vistas.PantallaInicio"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".vistas.PantallaListado"
            android:label="LISTADO DE USUARIOS" />
        <activity
            android:name=".vistas.PantallaCrudUsuario"
            android:label="DATOS DEL USUARIO" />
    </application>
</manifest>
